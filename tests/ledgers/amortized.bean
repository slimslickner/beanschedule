option "operating_currency" "USD"

2020-01-01 open Assets:Bank
2020-01-01 open Liabilities:Loan
2020-01-01 open Expenses:Interest
2020-01-01 open Equity:Opening-Balances

2025-12-31 * "Opening"
  Assets:Bank                 100000.00 USD
  Equity:Opening-Balances    -100000.00 USD

2025-12-31 * "Loan drawdown"
  Assets:Bank                 100000.00 USD
  Liabilities:Loan           -100000.00 USD

; An amortized schedule. The leg postings name the accounts; their amounts are
; placeholders the engine recomputes per occurrence.
2026-01-01 * "Chase" "Mortgage"
  id: "loan"
  rrule: "FREQ=MONTHLY;BYMONTHDAY=1"
  method: "static"
  rate: 0.06
  term: 360
  Assets:Bank                -1000.00 USD
  Liabilities:Loan             900.00 USD
    schedule-leg: "principal"
  Expenses:Interest            100.00 USD
    schedule-leg: "interest"
